# ============================================================
# AI 投研平台 — 环境变量配置模板
# 复制为 .env 后按实际环境修改
# ============================================================

# ── PostgreSQL ──────────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5433
PG_USER=postgres
PG_PASS=postgres
PG_DB=ai
# 完整连接串（部分脚本使用，优先于上面的分项配置）
PG_DSN=postgresql://postgres:postgres@localhost:5433/ai

# ── MinIO 对象存储 ──────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# upload_analysis_reports.py 使用的 root 凭据（同 access/secret）
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=documents

# ── Qdrant 向量数据库 ───────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ── Embedding 服务 (llama.cpp / Qwen3-Embedding-4B) ────────
EMBEDDING_URL=http://localhost:8001/v1/embeddings

# ── Crawl4AI 网页抓取服务 ───────────────────────────────────
CRAWL4AI_URL=http://localhost:11235
CRAWL4AI_API_TOKEN=crawl4ai-dev-token

# ── 数据目录（默认基于项目根目录推导，通常无需修改）─────────
# DATA_ROOT=/path/to/ai-platform/data
# REPORT_SOURCE_DIR=/path/to/ai-platform/data/reports
# VAULT_ROOT=/path/to/ai-platform/data/obsidian_vault
# PROVIDERS_YAML=/path/to/ai-platform/data/providers.yaml
