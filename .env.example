# ============================================================
# AI 投研平台 — 环境变量配置模板
# 复制为 .env 后按实际环境修改
# 注意：各服务运行在独立容器中，服务间统一通过宿主机 localhost:端口 通信；
#       即将各服务宿主机映射端口（如 5433/8080/9000/6333/8001/8002/5001/11235/27124）
#       作为服务访问地址，容器内通过 extra_hosts 的 localhost:host-gateway 映射访问宿主机。
# ============================================================

# ── PostgreSQL ──────────────────────────────────────────────
# 脚本层使用 PG_* 前缀
PG_HOST=localhost
PG_PORT=5433
PG_USER=postgres
PG_PASS=postgres
PG_DB=ai
# 完整连接串（部分脚本使用，优先于上面的分项配置）
PG_DSN=postgresql://postgres:postgres@localhost:5433/ai

# LangGraph 服务层使用 POSTGRES_* 前缀
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai

# 连接池 & 查询调优（可选，有合理默认值）
# PG_POOL_MIN_SIZE=5
# PG_POOL_MAX_SIZE=20
# PG_STATEMENT_TIMEOUT_MS=30000
# PG_HNSW_EF_SEARCH=100

# LangGraph Checkpoint 存储（异步驱动）
CHECKPOINT_CONNSTRING=postgresql+asyncpg://postgres:postgres@localhost:5433/langgraph

# ── MinIO 对象存储 ──────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# root 凭据（upload_analysis_reports.py 等使用）
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=documents

# ── Qdrant 向量数据库 ───────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ── LLM 推理服务 (sisyphus / vLLM) ─────────────────────────
# 统一通过宿主机 localhost:8080 访问
OPENAI_BASE_URL=http://localhost:8080/v1
OPENAI_API_KEY=sk-placeholder
MODEL_NAME=qwen3
# 脚本层别名（crawl_qiushi_summary.py 使用）
LLM_BASE_URL=http://localhost:8080/v1/chat/completions

# ── Embedding 服务 (llama.cpp / Qwen3-Embedding-4B) ────────
# 统一通过宿主机 localhost:8001 访问
EMBEDDING_URL=http://localhost:8001/v1
EMBEDDING_MODEL=embedding
# 超时 & 连接池（可选）
# EMBEDDING_CONNECT_TIMEOUT=5.0
# EMBEDDING_READ_TIMEOUT=120.0
# EMBEDDING_WRITE_TIMEOUT=30.0
# EMBEDDING_POOL_TIMEOUT=5.0
# EMBEDDING_MAX_CONNECTIONS=100
# EMBEDDING_KEEPALIVE_CONNECTIONS=20
# EMBEDDING_MAX_CONCURRENCY=8
# EMBEDDING_MAX_RETRIES=3

# ── Reranker 服务 (llama.cpp / Qwen3-Reranker-4B) ──────────
# 统一通过宿主机 localhost:8002 访问
RERANKER_URL=http://localhost:8002/v1
RERANKER_MODEL=reranker
# 超时 & 连接池（可选）
# RERANKER_CONNECT_TIMEOUT=5.0
# RERANKER_READ_TIMEOUT=120.0
# RERANKER_WRITE_TIMEOUT=30.0
# RERANKER_POOL_TIMEOUT=5.0
# RERANKER_MAX_CONNECTIONS=20
# RERANKER_KEEPALIVE_CONNECTIONS=5
# RERANKER_MAX_CONCURRENCY=2
# RERANKER_MAX_RETRIES=2
# RERANK_TOP_K=5
# RERANK_MAX_CHARS=1000

# ── Docling 文档解析服务 ────────────────────────────────────
# 统一通过宿主机 localhost:5001 访问
DOCLING_URL=http://localhost:5001

# ── SiYuan Knowledge Workspace ──────────────────────────────
# 统一通过宿主机 localhost:6806 访问（展示层，PostgreSQL 为 SoT）
SIYUAN_URL=http://localhost:6806
SIYUAN_ACCESS_AUTH_CODE=

# ── Crawl4AI 网页抓取服务 ───────────────────────────────────
CRAWL4AI_URL=http://localhost:11235
CRAWL4AI_API_TOKEN=crawl4ai-dev-token

# ── LangGraph 服务 ──────────────────────────────────────────
LANGGRAPH_PORT=8100
# 金融数据接口超时（秒）
# FINANCIAL_DATA_TIMEOUT=30.0

# ── 前端 (frontend/.env) ────────────────────────────────────
# 留空则使用 Vite 代理（/api → localhost:8100）
VITE_API_BASE_URL=

# ── 数据目录（默认基于项目根目录推导，通常无需修改）─────────
# DATA_ROOT=/mnt/e/ai-platform/data
# REPORT_SOURCE_DIR=/mnt/e/ai-platform/data/reports
# VAULT_ROOT=/mnt/e/ai-platform/data/vault
# PROVIDERS_YAML=/mnt/e/ai-platform/data/providers.yaml
