    "class"
   ],
   "complexity": "moderate",
   "languageNotes": ""
  },
  {
   "id": "file:langgraph/tools/embedding.py",
   "type": "file",
   "name": "embedding.py",
   "filePath": "langgraph/tools/embedding.py",
   "summary": "Embedding Tool - 统一 Embedding 调用层（Qwen3-Embedding-4B, :8001） 所有需要生成向量的模块必须通过 EmbeddingTool 调用， 禁止业务代码直接使用 httpx / requests / OpenAI SDK。",
