# Docling Serve with CUDA 13.3
# Upgraded from cu128 to cu133 for onnxruntime-gpu 1.27+
FROM nvidia/cuda:13.3.0-cudnn-devel-ubuntu24.04

LABEL maintainer="AI-Platform"
LABEL description="Docling Serve with CUDA 13.3 GPU OCR support"

# Install system dependencies
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y \
    python3 python3-pip python3-venv \
    git wget curl \
    libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Set Python environment
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_BREAK_SYSTEM_PACKAGES=1

# Install PyTorch with CUDA 13.0 support
RUN pip3 install torch torchvision --index-url https://download.pytorch.org/whl/cu130

# Install Docling and docling-serve
RUN pip3 install \
    docling \
    docling-core \
    docling-serve \
    docling-ibm-models \
    docling-jobkit \
    onnxruntime-gpu

# Create app directory and cache
WORKDIR /opt/app-root/src
RUN mkdir -p /opt/app-root/src/.cache/docling/models

# Copy bundled RapidOCR models to image (entrypoint will sync to volume)
RUN mkdir -p /opt/app-root/src/.cache/docling/models

# Entrypoint syncs models to volume on startup
COPY entrypoint.sh /opt/app-root/src/entrypoint.sh
RUN chmod +x /opt/app-root/src/entrypoint.sh
ENTRYPOINT ["/opt/app-root/src/entrypoint.sh"]

# Expose port
EXPOSE 5001

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=120s --retries=3 \
    CMD curl -f http://localhost:5001/health || exit 1

# Enable UI
ENV DOCLING_SERVE_ENABLE_UI=true \
    DOCLING_SERVE_ARTIFACTS_PATH=/opt/app-root/src/.cache/docling/models

# Run docling-serve
CMD ["docling-serve", "run", "--host", "0.0.0.0", "--port", "5001"]
